@model EntradasMvc.ViewModels.CotizacionInputViewModel

@{
    ViewData["Title"] = "Cotizar entradas";
}

<h1>Cotizar entradas</h1>
<p>Cada entrada cuesta Bs 50. Desde 5 entradas: 10 % de descuento.</p>

<form asp-controller="Entradas" asp-action="Calcular" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Cliente"></label>
        <input asp-for="Cliente" />
        <span asp-validation-for="Cliente"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cantidad"></label>
        <input asp-for="Cantidad" />
        <span asp-validation-for="Cantidad"></span>
    </div>

   
    <div class="mb-3">
    <label asp-for="TipoEntrada"></label>
    <select asp-for="TipoEntrada">
            <option value="">--Seleccione--</option>
            <option value="General">General</option>
            <option value="VIP">VIP</option>
            </select>
    <span asp-validation-for="TipoEntrada"></span>
    </div>

    <button type="submit" class="btn btn-primary">Calcular</button>


</form>





@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
